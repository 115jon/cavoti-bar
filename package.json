{
  "name": "cavoti-bar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pwsh -NoProfile -File ./scripts/tauri-dev.ps1",
    "dev:tauri": "vite --mode tauri",
    "build": "vite build",
    "build:tauri": "vite build --mode tauri",
    "build:release": "pwsh -NoProfile -File ./scripts/build-tauri-release.ps1",
    "build:android": "pwsh -NoProfile -File ./scripts/build-tauri-android-release.ps1",
    "install:android": "pwsh -NoProfile -File ./scripts/build-tauri-android-release.ps1 -Install",
    "build:installer": "pwsh -NoProfile -File ./scripts/build-tauri-installer.ps1",
    "run:release": "pwsh -NoProfile -File ./scripts/run-tauri-release.ps1",
    "release": "pwsh -NoProfile -File ./scripts/run-tauri-release.ps1 -Build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "biome format --write src",
    "format:check": "biome format src --error-on-warnings",
    "tailwind:check": "tailwind-suggest-canonical-classes \"src/**/*.{ts,tsx,jsx,js}\" --css src/index.css --check",
    "tailwind:fix": "tailwind-suggest-canonical-classes \"src/**/*.{ts,tsx,jsx,js}\" --css src/index.css",
    "tailwind:aliases:check": "bun scripts/tailwind-theme-aliases.ts --check",
    "tailwind:aliases:fix": "bun scripts/tailwind-theme-aliases.ts",
    "lint": "bun run tailwind:check && bun run tailwind:aliases:check && biome lint src",
    "lint:fix": "bun run tailwind:fix && bun run tailwind:aliases:fix && biome lint --write src && biome format --write src",
    "fix": "bun run lint:fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
