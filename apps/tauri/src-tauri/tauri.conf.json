{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cavoti Bar",
  "version": "0.1.0",
  "identifier": "com.cavoti.bar",
  "build": {
    "beforeDevCommand": "bun run --cwd ../../web dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ../../web build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cavoti Bar",
        "width": 430,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "script-src": "'self' 'unsafe-eval' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "capabilities": ["default", "desktop-capability", "auth"]
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["cavoti"], "host": "open" }],
      "desktop": { "schemes": ["cavoti"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMDM4ODM2M0MwNzgxRDMKUldUVGdRYzhOb2dEdkNVblRyOUFreEp3UFordVpsYlNxWElNVGpwbzZlMmdzc1U0UDYvT2ZNRUYK",
      "endpoints": ["https://github.com/115jon/cavoti-bar/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive",
        "installerArgs": ["/S"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "category": "Utility",
    "publisher": "115jon",
    "shortDescription": "Cavoti usage monitor",
    "longDescription": "A native Cavoti usage monitor with persistent authentication, desktop integration, and Android foreground support.",
    "homepage": "https://cavoti.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 1001
    },
    "windows": {}
  }
}
